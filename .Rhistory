simulate_funnel_device <- function(device_name, step_to_boost, boost_pct = 0.05) {
# Filter the device
sim <- device_step_counts %>% filter(device == device_name)
# Ensure lowercase step name
step_to_boost <- tolower(step_to_boost)
# Copy conversion rates
sim$sim_conversion <- sim$step_conversion_rate
# Apply boost
sim$sim_conversion[sim$step == step_to_boost] <-
sim$sim_conversion[sim$step == step_to_boost] * (1 + boost_pct)
# Initialize simulated users
sim$sim_users <- NA
sim$sim_users[1] <- sim$users[1]  # starting users
for(i in 1:(nrow(sim)-1)) {
sim$sim_users[i+1] <- sim$sim_users[i] * sim$sim_conversion[i]
}
sim_confirm <- sim$sim_users[nrow(sim)]
original_confirm <- sim$next_users[nrow(sim)-1]
tibble(
device = device_name,
boosted_step = step_to_boost,
boost_pct = boost_pct,
original_confirmations = round(original_confirm),
simulated_confirmations = round(sim_confirm),
increase = round(sim_confirm - original_confirm)
)
}
steps_to_sim <- c("home", "search", "payment")
devices <- unique(df_long$device)
sim_results_device <- map_df(devices, function(dev) {
map_df(steps_to_sim, simulate_funnel_device, device_name = dev, boost_pct = 0.05)
})
sim_results_device
ggplot(sim_results_device, aes(x = boosted_step, y = increase, fill = device)) +
geom_col(position = position_dodge(width = 0.7), width = 0.6) +
geom_text(aes(label = scales::comma(increase)),
position = position_dodge(width = 0.7), vjust = -0.5, size = 4) +
scale_fill_manual(values = device_colors) +
labs(
title = "Device-Specific Funnel Sensitivity Simulation (+5% Step Conversion)",
subtitle = "Estimated increase in confirmations if step conversion improves",
x = "Step Boosted",
y = "Additional Confirmations",
fill = "Device"
) +
