library(tidyverse)
library(tidytext)
library(dplyr)
library(wordcloud)
library(RColorBrewer)
library(stats)
reviews <- read.csv("Spotify_User_Reviews.csv")
reviews <- reviews %>%
mutate(review_id = row_number())
tokens <- reviews %>%
unnest_tokens(word, Review) %>%
anti_join(tidytext::stop_words, by = "word") %>%
filter(!str_detect(word, "^[0-9]+$"))
word_counts_wide <- tokens %>%
count(word, label) %>%
pivot_wider(
names_from = label,
values_from = n,
values_fill = 0
) %>%
mutate(total = POSITIVE + NEGATIVE) %>%
arrange(desc(total))
word_counts_wide
word_counts_wide$diff <- round(word_counts_wide$NEGATIVE/word_counts_wide$POSITIVE, 2)
word_counts_wide <- word_counts_wide %>%
mutate(diff = if_else(
POSITIVE == 0,
NA_real_,
round(NEGATIVE - POSITIVE, 2)
))
word_counts_wide <- word_counts_wide %>%
mutate(
log_odds = log((NEGATIVE + 1) / (POSITIVE + 1))
)
top50 <- word_counts_wide %>%
arrange(desc(diff))# %>%
#slice_head(n = 50)
neg_themes <- word_counts_wide %>%
arrange(desc(diff))# %>%
#slice_head(n = 30)
pos_themes <- word_counts_wide %>%
arrange(diff) #%>%
#slice_head(n = 30)
top_words <- word_counts_wide %>%
filter(total >= 100) %>%
arrange(desc(abs(log_odds))) %>%
slice_head(n = 500)
ggplot(top_words, aes(
x = reorder(word, log_odds),
y = log_odds,
fill = log_odds > 0
)) +
geom_col() +
coord_flip() +
theme_minimal() +
labs(x = NULL, y = "Log-odds (Negative vs Positive)")
mat <- word_counts_wide %>%
filter(total >= 100) %>%
select(NEGATIVE, POSITIVE) %>%
scale()
k <- 10
clusters <- kmeans(mat, centers = k)
word_counts_wide$cluster <- NA
word_counts_wide$cluster[word_counts_wide$total >= 100] <- clusters$cluster
word_counts_wide %>%
group_by(cluster) %>%
slice_max(total, n = 10)
neg_words <- word_counts_wide %>%
filter(total >= 100) %>%
mutate(diff = NEGATIVE - POSITIVE) %>%
arrange(desc(diff)) %>%
slice_head(n = 20)
ggplot(neg_words, aes(
x = reorder(word, diff),
y = diff
)) +
geom_col(fill = "firebrick") +
coord_flip() +
theme_minimal() +
labs(
title = "Words Most Associated with Negative Reviews",
x = NULL,
y = "NEGATIVE − POSITIVE"
)
pos_words <- word_counts_wide %>%
filter(total >= 100) %>%
mutate(diff = NEGATIVE - POSITIVE) %>%
arrange(diff) %>%
slice_head(n = 20)
ggplot(pos_words, aes(
x = reorder(word, diff),
y = diff
)) +
geom_col(fill = "steelblue") +
coord_flip() +
theme_minimal() +
labs(
title = "Words Most Associated with Positive Reviews",
x = NULL,
y = "NEGATIVE − POSITIVE"
)
top_words <- word_counts_wide %>%
filter(total >= 100) %>%
mutate(diff = NEGATIVE - POSITIVE) %>%
arrange(desc(abs(diff))) %>%
slice_head(n = 30)
ggplot(top_words, aes(
x = reorder(word, diff),
y = diff,
fill = diff > 0
)) +
geom_col(show.legend = FALSE) +
coord_flip() +
scale_fill_manual(values = c("steelblue", "firebrick")) +
theme_minimal() +
labs(
title = "Words with Strongest Sentiment Differences",
x = NULL,
y = "NEGATIVE − POSITIVE"
)
bubble_data <- word_counts_wide %>%
filter(total >= 200) %>%
mutate(diff = NEGATIVE - POSITIVE) %>%
arrange(desc(abs(diff))) %>%
slice_head(n = 40)
ggplot(bubble_data, aes(
x = diff,
y = reorder(word, diff),
size = total,
color = diff > 0
)) +
geom_point(alpha = 0.7) +
scale_color_manual(values = c("steelblue", "firebrick")) +
theme_minimal() +
labs(
title = "Theme Strength vs Frequency",
x = "NEGATIVE − POSITIVE",
y = NULL,
size = "Total Count"
)
top_words <- word_counts_wide %>%
filter(total >= 100) %>%
mutate(log_odds = log((NEGATIVE + 1) / (POSITIVE + 1))) %>%
arrange(desc(abs(log_odds))) %>%
slice_head(n = 30)
wordcloud(
words = top_words$word,
freq  = abs(top_words$log_odds),
colors = ifelse(top_words$log_odds > 0, "red", "blue"),
random.order = FALSE
)
cluster_summary <- word_counts_wide %>%
filter(!is.na(cluster)) %>%
group_by(cluster) %>%
slice_max(total, n = 10)
ggplot(cluster_summary, aes(
x = reorder(word, total),
y = total
)) +
geom_col() +
coord_flip() +
facet_wrap(~ cluster, scales = "free_y") +
theme_minimal() +
labs(
title = "Word Clusters (Themes)",
x = NULL,
y = "Total Count"
)
word_counts_wide <- word_counts_wide %>%
#filter(total >= 100) %>%   # remove noise
mutate(log_odds = log((NEGATIVE + 1) / (POSITIVE + 1)))
mat <- word_counts_wide %>%
select(NEGATIVE, POSITIVE, log_odds) %>%
scale()
set.seed(123)
k <- 6  # try 5–8
clusters <- kmeans(mat, centers = k)
word_counts_wide$cluster <- clusters$cluster
theme_words <- word_counts_wide %>%
group_by(cluster) %>%
arrange(desc(abs(log_odds)), desc(total)) %>%
#slice_head(n = 10) %>%
ungroup()
theme_dictionary <- list(
Pricing = c("price", "pay", "premium", "ads", "subscription"),
Playback = c("play", "skip", "shuffle", "offline", "buffer"),
UI = c("app", "interface", "update", "design", "layout"),
Discovery = c("playlist", "recommend", "discover", "algorithm"),
Accounts = c("login", "account", "password", "email"),
Performance = c("crash", "slow", "bug", "freeze", "lag")
)
# Score each cluster
assign_theme <- function(words, dict) {
scores <- sapply(dict, function(keys) sum(words %in% keys))
if (max(scores) == 0) return("Other")
names(scores)[which.max(scores)]
}
theme_labels <- theme_words %>%
group_by(cluster) %>%
summarise(
theme = assign_theme(word, theme_dictionary),
.groups = "drop"
)
word_counts_wide <- word_counts_wide %>%
left_join(theme_labels, by = "cluster")
ggplot(theme_words, aes(
x = reorder(word, abs(log_odds)),
y = abs(log_odds)
)) +
geom_col() +
coord_flip() +
facet_wrap(~ cluster, scales = "free_y") +
theme_minimal() +
labs(
title = "Automatically Identified Themes",
x = NULL,
y = "Theme Strength"
)
