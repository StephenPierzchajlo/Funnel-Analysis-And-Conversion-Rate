# Step counts
step_counts <- df_long %>%
group_by(step) %>%
summarise(users = n_distinct(user_id), .groups = "drop") %>%
mutate(step = factor(step, levels = c("home", "search", "payment", "confirmation"))) %>%
arrange(step)
# Step-to-step conversions
step_counts <- step_counts %>%
mutate(
next_users = lead(users),
step_conversion_rate = next_users / users
)
# Function to simulate improved step conversion
simulate_funnel <- function(step_to_boost, boost_pct = 0.05) {
# Copy original counts
sim <- step_counts
# Apply boost
sim$step_conversion_rate[sim$step == step_to_boost] <-
sim$step_conversion_rate[sim$step == step_to_boost] * (1 + boost_pct)
# Recalculate downstream users
sim$sim_users <- NA
sim$sim_users[1] <- sim$users[1]  # start with Home users
for(i in 1:(nrow(sim)-1)) {
sim$sim_users[i+1] <- sim$sim_users[i] * sim$step_conversion_rate[i]
}
# Return impact at Confirmation
sim_confirm <- sim$sim_users[nrow(sim)]
original_confirm <- sim$next_users[nrow(sim)]
data.frame(
boosted_step = step_to_boost,
boost_pct = boost_pct,
original_confirmations = original_confirm,
simulated_confirmations = round(sim_confirm),
increase = round(sim_confirm - original_confirm)
)
}
# Example: simulate +5% improvement at Search → Payment
simulate_funnel("search")
steps <- c("home", "search", "payment")
sim_results <- map_df(steps, simulate_funnel, boost_pct = 0.05)
sim_results
ggplot(sim_results, aes(x = boosted_step, y = increase, fill = boosted_step)) +
geom_col(width = 0.6) +
geom_text(aes(label = scales::comma(increase)), vjust = -0.5, size = 5) +
scale_fill_manual(values = c("#2c7fb8", "#7fcdbb", "#fdae61")) +
labs(
title = "Funnel Sensitivity Simulation (+5% Step Conversion)",
subtitle = "Estimated increase in final confirmations if step conversion is improved",
x = "Boosted Step",
y = "Additional Confirmations"
) +
theme_minimal(base_size = 14) +
theme(legend.position = "none")
library(tidyverse)
# 1. Step counts
step_counts <- df_long %>%
group_by(step) %>%
summarise(users = n_distinct(user_id), .groups = "drop") %>%
mutate(step = factor(step, levels = c("home", "search", "payment", "confirmation"))) %>%
arrange(step)
# 2. Step-to-step conversion
step_counts <- step_counts %>%
mutate(
next_users = lead(users),
step_conversion_rate = next_users / users
)
# 3. Safe simulation function
simulate_funnel <- function(step_to_boost, boost_pct = 0.05) {
# Make sure step name is lowercase
step_to_boost <- tolower(step_to_boost)
sim <- step_counts
sim$sim_conversion <- sim$step_conversion_rate
# Apply boost only to the chosen step
sim$sim_conversion[sim$step == step_to_boost] <-
sim$sim_conversion[sim$step == step_to_boost] * (1 + boost_pct)
# Initialize simulated users
sim$sim_users <- NA
sim$sim_users[1] <- sim$users[1]  # Home users
# Loop through steps to propagate downstream users
for(i in 1:(nrow(sim)-1)) {
sim$sim_users[i+1] <- sim$sim_users[i] * sim$sim_conversion[i]
}
# Calculate final impact
sim_confirm <- sim$sim_users[nrow(sim)]
original_confirm <- sim$next_users[nrow(sim) - 1]  # original confirmations
# Return a single-row dataframe for plotting
tibble(
boosted_step = step_to_boost,
boost_pct = boost_pct,
original_confirmations = round(original_confirm),
simulated_confirmations = round(sim_confirm),
increase = round(sim_confirm - original_confirm)
)
}
# 4. Simulate +5% improvement for each step except last
steps_to_sim <- c("home", "search", "payment")
sim_results <- map_df(steps_to_sim, simulate_funnel, boost_pct = 0.05)
# 5. Plot safely
ggplot(sim_results, aes(x = boosted_step, y = increase, fill = boosted_step)) +
geom_col(width = 0.6) +
geom_text(aes(label = scales::comma(increase)), vjust = -0.5, size = 5) +
scale_fill_manual(values = c("#2c7fb8", "#7fcdbb", "#fdae61")) +
labs(
title = "Funnel Sensitivity Simulation (+5% Step Conversion)",
subtitle = "Estimated increase in final confirmations if step conversion is improved",
x = "Boosted Step",
y = "Additional Confirmations"
) +
theme_minimal(base_size = 14) +
theme(legend.position = "none")
